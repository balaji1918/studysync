# Copy these into your IDE run configuration or terminal. NEVER commit real values.
DB_URL=jdbc:mysql://localhost:3306/studysync?serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=studysync
DB_PASSWORD=change-me
SESSION_COOKIE_SECURE=false
CONTACT_EMAIL=

# Local default; Render supplies PORT automatically.
PORT=8080
# On Render set prod and SESSION_COOKIE_SECURE=true.
SPRING_PROFILES_ACTIVE=default
# DB_URL must be a JDBC URL, not mysql:// (see README Render section).
